<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 微信登录 Universal Link 回调（https://ai-card.app.reai.com/link/）；
	     AASA 位于 https://ai-card.app.reai.com/.well-known/apple-app-site-association，见 docs/RELEASE.md「微信登录配置」节。
	     前置：Apple Developer 后台对应 App ID 需开启 Associated Domains capability。 -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:ai-card.app.reai.com</string>
	</array>
	<!-- 已有 HealthKit。临床病历需要 com.apple.developer.healthkit.access，
	     当前描述文件没有这项，不要在这里补。后台静默唤醒还需要门户里的
	     HealthKit Background Delivery（com.apple.developer.healthkit.background-delivery）；
	     门户未开通前不要写入该键，否则现有签名会失败。 -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.reai.recordingcard</string>
	</array>
</dict>
</plist>
