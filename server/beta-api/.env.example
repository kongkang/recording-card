# AI Card (录音卡) Beta Email Verification & TestFlight Invite API configuration
# Copy to /etc/ai-card-beta-api/official.env (chmod 600) on production server.

HOST=127.0.0.1
PORT=8790
DB_PATH=/var/lib/ai-card-beta-api/beta.sqlite3

# Generate random 32-byte hex secrets: `openssl rand -hex 32`
CODE_PEPPER=replace-with-random-hex
IP_HASH_SALT=replace-with-random-hex

# OTP settings
CODE_TTL_SECONDS=600
COOLDOWN_SECONDS=60
MAX_VERIFY_ATTEMPTS=5

# Outbound SMTP (Feishu / Resend / etc.)
SMTP_HOST=smtp.feishu.cn
SMTP_PORT=587
SMTP_USE_SSL=0
SMTP_USER=noreply@wainao.ai
SMTP_PASS=replace-with-smtp-password
SMTP_FROM_NAME=录音卡
SMTP_FROM_EMAIL=noreply@wainao.ai
SMTP_REPLY_TO=support@reai.chat

# App Store Connect API (keep .p8 outside git with chmod 600)
ASC_APP_ID=6834316655
ASC_EXTERNAL_GROUP_ID=4fc99575-cdf1-4295-9535-0ba901375c32
ASC_KEY_ID=replace-with-asc-key-id
ASC_ISSUER_ID=replace-with-asc-issuer-id
ASC_KEY_PATH=/etc/ai-card-beta-api/AuthKey_REPLACE.p8
PUBLIC_TESTFLIGHT_URL=https://testflight.apple.com/join/fMWkZSv5
