[Unit]
Description=AI Card (Recording Card) Official Beta Email Verification & TestFlight Invite API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ai-card-beta-api
EnvironmentFile=/etc/ai-card-beta-api/official.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /opt/ai-card-beta-api/app.py
Restart=always
RestartSec=2
User=root
Group=root
NoNewPrivileges=true
UMask=0077
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/ai-card-beta-api

[Install]
WantedBy=multi-user.target
